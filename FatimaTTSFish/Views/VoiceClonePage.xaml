<Page x:Class="FatimaTTS.Views.VoiceClonePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgContentBrush}"
      FontFamily="Segoe UI">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Padding="24,18,24,14"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Clone a Voice"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Build a reusable voice model from your own audio samples"
                           Style="{StaticResource TextMuted}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: Clone form ═══ -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24" MaxWidth="620">

                    <!-- Title -->
                    <TextBlock Text="VOICE TITLE" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="TitleBox"
                             Style="{StaticResource InputStyle}"
                             Height="36" Margin="0,0,0,14"
                             Tag="e.g. Santiago Narration"/>

                    <!-- Description -->
                    <TextBlock Text="DESCRIPTION (OPTIONAL)" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="DescriptionBox"
                             Style="{StaticResource InputStyle}"
                             Height="36" Margin="0,0,0,14"
                             Tag="What is this voice for?"/>

                    <!-- Visibility -->
                    <TextBlock Text="VISIBILITY" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="VisibilityCombo"
                              Style="{StaticResource ComboStyle}"
                              Margin="0,0,0,14">
                        <ComboBoxItem Content="Private — only you" Tag="private" IsSelected="True"/>
                        <ComboBoxItem Content="Unlisted — anyone with the link" Tag="unlist"/>
                    </ComboBox>

                    <!-- Audio samples -->
                    <TextBlock Text="AUDIO SAMPLES" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Clean, mono, single-speaker audio gives the best result. A short clip works for a quick clone; a minute or two of clear speech improves fidelity. Avoid background music, reverb, and overlapping voices. .wav, .mp3, .m4a, or .opus — up to 20 files."
                                       Style="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Button x:Name="ChooseSamplesButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ChooseSamplesButton_Click"
                                    Height="34" Padding="14,0"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Choose Audio Files…" FontSize="12"/>
                            </Button>

                            <ItemsControl x:Name="SampleFilesList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,7"
                                                Background="{DynamicResource BgInputBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Width="24" Height="24"
                                                        Tag="{Binding}"
                                                        Click="RemoveSample_Click"
                                                        Foreground="{DynamicResource DangerBrush}">
                                                    <TextBlock Text="✕" FontSize="10"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoSamplesText"
                                       Text="No files chosen yet"
                                       Style="{StaticResource TextMuted}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="EnhanceQualityCheck"
                              Content="Enhance audio quality (denoise + normalize before training)"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="12" IsChecked="True"
                              Margin="0,10,0,20"/>

                    <!-- Clone button -->
                    <Button x:Name="CloneButton"
                            Style="{StaticResource CtaButtonStyle}"
                            Click="CloneButton_Click"
                            Height="44"
                            Content="✦  Clone Voice"/>

                    <!-- Progress / result -->
                    <Border x:Name="ResultPanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource BgInputBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="14,12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ResultTitleText"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Reference ID"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ResultIdBox"
                                         Grid.Column="0"
                                         Style="{StaticResource InputStyle}"
                                         Height="34" IsReadOnly="True"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CopyResultId_Click"
                                        Margin="8,0,0,0" Height="34" Padding="12,0">
                                    <TextBlock Text="Copy" FontSize="12"/>
                                </Button>
                            </Grid>
                            <Button Style="{StaticResource CtaButtonStyle}"
                                    Height="36" Margin="0,10,0,0"
                                    Click="UseInGenerate_Click">
                                <TextBlock Text="Use in Generate Speech" FontSize="12" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ RIGHT: Your cloned voices ═══ -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BgSidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel Margin="16,16,16,16">

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="YOUR VOICES" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshMyVoices_Click"
                                Height="26" Padding="10,0" FontSize="11">
                            <TextBlock Text="↻  Refresh"/>
                        </Button>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="MyVoicesEmptyText"
                                       Text="No voices yet"
                                       Style="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <ItemsControl x:Name="MyVoicesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,8"
                                                Background="{DynamicResource BgInputBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StateAndVisibility}"
                                                           Style="{StaticResource TextMuted}"
                                                           Margin="0,2,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Id}"
                                                               FontSize="10" FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Width="24" Height="24"
                                                            Tag="{Binding Id}"
                                                            Click="CopyVoiceId_Click"
                                                            ToolTip="Copy Reference ID">
                                                        <TextBlock Text="⧉" FontSize="12"/>
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Width="24" Height="24"
                                                            Tag="{Binding Id}"
                                                            Click="EditVoice_Click"
                                                            ToolTip="Rename / change visibility">
                                                        <TextBlock Text="✎" FontSize="12"/>
                                                    </Button>
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Width="24" Height="24"
                                                            Tag="{Binding Id}"
                                                            Click="DeleteVoice_Click"
                                                            Foreground="{DynamicResource DangerBrush}"
                                                            ToolTip="Delete voice">
                                                        <TextBlock Text="✕" FontSize="11"/>
                                                    </Button>
                                                </Grid>

                                                <!-- Inline edit panel -->
                                                <StackPanel Visibility="{Binding EditPanelVisibility}"
                                                            Margin="0,10,0,0">
                                                    <Border Height="1"
                                                            Background="{DynamicResource BorderSubtleBrush}"
                                                            Margin="0,0,0,10"/>
                                                    <TextBlock Text="Title" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource InputStyle}"
                                                             Height="30" Margin="0,0,0,8"/>
                                                    <TextBlock Text="Visibility" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,0,0,4"/>
                                                    <ComboBox Style="{StaticResource ComboStyle}"
                                                              Height="30" Margin="0,0,0,10"
                                                              SelectedIndex="{Binding EditVisibilityIndex, Mode=TwoWay}">
                                                        <ComboBoxItem Content="Private — only you"/>
                                                        <ComboBoxItem Content="Unlisted — anyone with the link"/>
                                                    </ComboBox>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Cancel"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Height="28" Padding="10,0" FontSize="11"
                                                                Tag="{Binding Id}"
                                                                Click="CancelEditVoice_Click"
                                                                Margin="0,0,8,0"/>
                                                        <Button Content="Save"
                                                                Style="{StaticResource CtaButtonStyle}"
                                                                Height="28" Padding="10,0" FontSize="11"
                                                                Tag="{Binding Id}"
                                                                Click="SaveEditVoice_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Page>
